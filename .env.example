# Docker Compose environment. Copy to .env and change every password/secret.
MYSQL_DATABASE=chat_knowledge
MYSQL_USER=zhiwen
MYSQL_PASSWORD=please-change-this-db-password
MYSQL_ROOT_PASSWORD=please-change-this-root-password

# Generate with: openssl rand -hex 32
SECRET_KEY=please-change-this-to-a-random-64-char-secret

# mock works without a key. Set provider + key for real answers.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Create demo@zhiwen.app / Demo1234 on first boot. Disable in production.
SEED_DEMO=true

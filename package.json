{
  "name": "chat-knowledge",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "prepare": "husky",
    "lint": "npm --prefix frontend run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "npm --prefix frontend run lint:fix",
      "prettier --write"
    ],
    "frontend/**/*.{css,json,md}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
